import("//build/rust/rust_static_library.gni")

# Rust FFI bridge for liburlpattern
#
# This target provides a C++-compatible interface to the urlpattern crate.
# It uses cxx for safe C++/Rust interop.
#
# IMPORTANT: This target cannot be built until the urlpattern crate is added
# to Chromium. See ../CRATE_ADDITION_GUIDE.md for instructions.

rust_static_library("liburlpattern_ffi") {
  crate_root = "src/lib.rs"
  crate_name = "liburlpattern_ffi"
  
  sources = [
    "src/lib.rs",
  ]
  
  # Dependencies
  deps = [
    # TODO: Uncomment once urlpattern crate is added
    # "//third_party/rust/urlpattern/v0_3:lib",
    
    # cxx is already available in Chromium
    "//third_party/rust/cxx/v1:lib",
  ]
  
  # Generate C++ bridge headers using cxx
  # This creates a header file that C++ can include
  cxx_bindings = [
    "src/lib.rs",
  ]
  
  # Allow unsafe code (required for cxx FFI boundary)
  allow_unsafe = true
  
  # This is a first-party crate
  visibility = [
    "//third_party/liburlpattern:*",
    "//third_party/liburlpattern_rs:*",
  ]
}

# Test target for the FFI bridge
# Run with: autoninja -C out/Default liburlpattern_ffi_unittests
rust_unit_test("liburlpattern_ffi_unittests") {
  crate_root = "src/lib.rs"
  
  sources = [
    "src/lib.rs",
  ]
  
  deps = [
    # TODO: Uncomment once urlpattern crate is added
    # "//third_party/rust/urlpattern/v0_3:lib",
    "//third_party/rust/cxx/v1:lib",
  ]
  
  allow_unsafe = true
}
